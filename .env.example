# ==============================================================================
# CELESTIAL — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local overrides.
# Sensible defaults are automatically provided for local development and Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT (Local Defaults / Automatic on Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CELESTIAL"
# Local development default: http://localhost:3000
# On Vercel, this is automatically inferred from VERCEL_URL if omitted.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. EXTERNAL ASTRONOMY DATA APIS (Defaults Provided)
# ------------------------------------------------------------------------------
# NASA Open APIs key (defaults to DEMO_KEY for exploration and development)
# Request a production key at: https://api.nasa.gov/
NASA_API_KEY="DEMO_KEY"

# JPL Horizons & CDS SIMBAD TAP Endpoints (Valid defaults provided)
HORIZONS_API_BASE_URL="https://ssd.jpl.nasa.gov/api/horizons.api"
SIMBAD_TAP_URL="https://simbad.cds.unistra.fr/simbad/sim-tap"

# ------------------------------------------------------------------------------
# 3. OPTIONAL DATABASE & AUTH (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# CELESTIAL operates fully stand-alone with curated in-memory and static catalogs.
# Supabase is completely optional. Leave these commented out unless you are
# actively integrating custom user profiles or remote persistence.
#
# NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-public-key>"
# SUPABASE_SERVICE_ROLE_KEY="<your-service-role-secret-key>"
