# ==============================================================================
# CELESTIAL — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development overrides.
# Sensible development defaults are automatically applied if variables are omitted.
#
# On Vercel:
# - NEXT_PUBLIC_APP_URL will be automatically inferred from VERCEL_URL if not set.
# - HORIZONS_API_BASE_URL & SIMBAD_TAP_URL default to official public endpoints.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT (Defaults provided for Local & Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CELESTIAL
# Local default: http://localhost:3000
# Vercel production: https://<your-project>.vercel.app (auto-inferred if omitted)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. EXTERNAL ASTRONOMY DATA APIS (Valid Public Defaults Provided)
# ------------------------------------------------------------------------------
# NASA Open APIs: https://api.nasa.gov/ (DEMO_KEY is valid for testing)
NASA_API_KEY=DEMO_KEY

# NASA JPL Horizons API & CDS SIMBAD TAP Endpoints
HORIZONS_API_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
SIMBAD_TAP_URL=https://simbad.cds.unistra.fr/simbad/sim-tap

# ------------------------------------------------------------------------------
# 3. OPTIONAL DATABASE & AUTH (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# CELESTIAL is fully operational standalone with zero database requirements.
# Leave these commented out unless you are actively integrating custom remote DB.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>
