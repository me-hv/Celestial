# CELESTIAL Environment Configuration Template
# Copy this file to .env.local for local development.

# Application Configuration
NEXT_PUBLIC_APP_NAME="CELESTIAL"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (Supabase / PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# External Astronomy Data APIs (Future Ingestion Pipelines)
# NASA Open APIs: https://api.nasa.gov/
NASA_API_KEY="DEMO_KEY"

# ESA / Horizons / Minor Planet Center Endpoints
HORIZONS_API_BASE_URL="https://ssd.jpl.nasa.gov/api/horizons.api"
SIMBAD_TAP_URL="https://simbad.cds.unistra.fr/simbad/sim-tap"
